# Simanga Configuration Example
# Copy this file to .env and customize as needed

# Logging
LOG_LEVEL=info

# nHentai Configuration
NHENTAI_COOKIE=
NHENTAI_QUERY=full color

# MangaDex Configuration  
MANGADX_QUERY=Solo Leveling

# Proxy Configuration (used by httpClient when proxy settings are enabled)
# Format: http://host:port, https://host:port, socks://host:port, socks5://host:port
PROXIES=

# Request Timeouts (milliseconds)
DEFAULT_TIMEOUT=20000
PUPPETEER_TIMEOUT=30000

# Feature Flags
INCLUDE_MATURE=0

# Development
NODE_TLS_REJECT_UNAUTHORIZED=0
