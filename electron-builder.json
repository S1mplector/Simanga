{
  "appId": "com.example.simanga",
  "productName": "SiManga",
  "files": [
    "dist/**/*",
    "node_modules/**/*",
    "package.json",
    "src/assets/icons/**/*",
    "extras/**/*"
  ],
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "mac": {
    "target": "dmg",
    "icon": "src/assets/icons/simanga.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "src/assets/icons/simanga.icns"
  },
  "win": {
    "target": "nsis",
    "icon": "src/assets/icons/simanga.ico"
  }
}