{
  "name": "simanga",
  "version": "0.1.0",
  "description": "Electron-based manga reader similar to HakuNeko",
  "main": "dist/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc -p tsconfig.main.json",
    "start": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json -w\" \"wait-on dist/main.js && electron .\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "p-queue": "^6.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2",
    "@heroicons/react": "^2.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.7",
    "concurrently": "^8.2.2",
    "electron": "^29.3.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.4.2",
    "ts-node": "^10.9.2",
    "vite": "^5.2.0",
    "wait-on": "^7.1.2",
    "@types/react": "^18.2.53",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.0",
    "@types/electron": "latest",
    "tailwindcss": "^3.4.4",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "react-router-dom": "^6.23.0",
    "@types/react-router-dom": "^5.3.3",
    "@tailwindcss/line-clamp": "^0.4.4"
  }
} 