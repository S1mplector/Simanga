{
  "name": "simanga",
  "version": "0.1.0",
  "description": "Electron-based manga reader similar to HakuNeko",
  "main": "dist/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc -p tsconfig.main.json",
    "start": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json -w\" \"wait-on dist/main.js && electron .\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test:adapters": "node -r ts-node/register src/adapters/adapters-tests/test-all.ts",
    "test:adapters:mature": "INCLUDE_MATURE=1 node -r ts-node/register src/adapters/adapters-tests/test-all.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@types/cheerio": "^0.22.35",
    "cheerio": "^1.1.0",
    "electron-store": "^8.2.0",
    "https-proxy-agent": "^7.0.6",
    "idb-keyval": "^6.2.2",
    "node-fetch": "^2.7.0",
    "p-queue": "^6.6.2",
    "puppeteer": "^24.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0",
    "sharp": "^0.34.2",
    "socks": "^2.8.5",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^7.11.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/electron": "latest",
    "@types/node": "^20.11.7",
    "@types/react": "^18.2.53",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^29.3.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2",
    "vite": "^5.2.0",
    "wait-on": "^7.1.2"
  }
}
